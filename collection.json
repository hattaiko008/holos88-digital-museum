  "relationshipPreview": [
    {
      "id": "tree",
      "title": "Survivor Tree",
      "heading": "Survivor Tree → Seed",
      "text": "一本の樹木を、種という小さな単位から見つめ直す。何が受け継がれ、どこへ運ばれていくのだろう。"
    },
    {
      "id": "seed",
      "title": "Seed",
      "heading": "Seed → Memory",
      "text": "種を残すこと。記憶を残すこと。生命の継承と、人が語り継ぐ営みを並べて考える。"
    },
    {
      "id": "memory",
      "title": "Memory",
      "heading": "Memory → Fukushima",
      "text": "場所は、出来事をどのように記憶するのだろう。ニューヨークから福島へ、樹木と人の関係を辿るための問い。"
    },
    {
      "id": "fukushima",
      "title": "Fukushima",
      "heading": "Fukushima → Earth",
      "text": "三春滝桜という一本の樹木から、土地、暮らし、地球へ。小さな場所を通して、世界を見つめる。"
    },
    {
      "id": "earth",
      "title": "Earth",
      "heading": "Earth → Life",
      "text": "世界を辿ったあと、日々のLifeへ。足元の土や目の前の木は、どんなつながりを持っているだろう。"
    }
  ],
